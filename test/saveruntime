#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/visave.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
cp "$root/save.c" "$root/save.h" "$root/os.asm" "$work/"
cp "$root/test/saveprobe.c" "$work/saveprb.c"
cd "$work"
aztec43_acc -c -o os.o os.asm
for target in c d11 c86; do
    case $target in
        c) output=save.exe; target_flag=-target=dos2; extra=;;
        d11) output=save.com; target_flag=-target=dos1; extra=;;
        c86) output=save.cmd; target_flag=-target=cpm86; extra=os.o;;
    esac
    aztec43_acc $target_flag -I. -squeeze -c -o save.o save.c
    aztec43_acc $target_flag -I. -squeeze -c -o probe.o saveprb.c
    aztec43_acc $target_flag -o "$output" probe.o save.o $extra
    if [ "$target" = d11 ]; then
        echo "VI SAVE RUNTIME SKIP: d11 truncate behavior is not modeled by stock emu2"
        if [ -n "${SAVE_TEST_OUTPUT:-}" ]; then
            mkdir -p "$SAVE_TEST_OUTPUT"
            cp "$output" "$SAVE_TEST_OUTPUT/"
        fi
        continue
    fi
    output_text=$(EMU2_CPM_VER=2.2 emu2 "$output")
    printf '%s\n' "$output_text"
    printf '%s\n' "$output_text" | tr -d '\r' | grep -qx 'VI SAVE PASS: 0 failures'
    if [ -n "${SAVE_TEST_OUTPUT:-}" ]; then
        mkdir -p "$SAVE_TEST_OUTPUT"
        cp "$output" "$SAVE_TEST_OUTPUT/"
    fi
    echo "VI SAVE RUNTIME PASS: $target"
done
